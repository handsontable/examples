# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.
#
# Loaded automatically by index.js via Node's built-in process.loadEnvFile().
# Priority: .env.local > .env. Values set in the real environment (Render,
# Docker, shell export) always win — the file loader does not overwrite them.

# --- GitHub ---------------------------------------------------------------
# Personal access token or fine-grained token with `public_repo` scope.
# Anonymous calls to the GitHub API are limited to 60/h per IP — set this
# to avoid the /api/changelog-prs endpoint hitting rate limits.
GITHUB_TOKEN=

# --- /api/changelog-prs cache --------------------------------------------
# Redis is optional. If unset or unreachable, the service falls back to a
# local filesystem cache automatically.
# Examples:
#   REDIS_URL=redis://127.0.0.1:6379
#   REDIS_URL=rediss://default:password@host.example.com:6380/0
REDIS_URL=

# Directory for the file-backed cache (default: ./.changelog-prs-cache)
# CACHE_DIR=./.changelog-prs-cache

# --- CodeSandbox (used by /codesandbox-vm and /codesandbox-browser) ------
CSB_API_KEY=

# --- Optional --------------------------------------------------------------
# PORT=3000
# SLACK_WEBHOOK=
# HANDSONTABLE_MAX_MAJOR=19
# CODESANDBOX_AWAIT_INSTALL=false
# CODESANDBOX_INSTALL_RETRY_ATTEMPTS=2
# CODESANDBOX_INSTALL_RETRY_MS=5000
