node_modules
deno.lock
dist
.cache
.DS_Store
.angular

# editors / tooling — local state stays out, committed skills stay in
.vscode
.idea/
.claude/*
!.claude/skills/

# local environment
.env
.env.local
# Symfony ships a committed .env of non-secret defaults; secrets go in .env.local
!server-examples/symfony/symfony/.env
*.log

# playwright e2e output, when a run is launched from the repo root rather than runner/
test-results/
playwright-report/
.playwright-mcp/

# Angular build output served by the symfony example's vite middleware; the real
# one lives in server-examples/symfony/frontend-angular/dist/ (covered by `dist`)
angular-assets/

# TypeScript incremental build cache (regenerated by every `tsc -b`)
*.tsbuildinfo
