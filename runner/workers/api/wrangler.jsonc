{
  // Sharing + Tier-2 orchestration Worker for the Handsontable demo runner.
  // Deployed to the main Handsontable Cloudflare account (NOT the sandbox).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handsontable-demos-api",
  "account_id": "15111272c53ed0aaf84a908f0c9c7f8b",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // ADR-0041 §D answers the "full fidelity is a spike amplifier" worry this
  // comment used to raise with `invocation_logs: false` and the silent preview
  // proxy path (src/index.ts), not with a low sampling rate: `head_sampling_rate:
  // 1.0` here is safe *because* nothing is logged per proxied preview request and
  // every non-proxy request emits exactly one structured line, not the platform's
  // own per-invocation logging. Loki keeps 90 days of the exported worker stream
  // (contract §E.4); Sentry, not Workers Logs, stays the fault channel regardless
  // (`invocation_logs: false` — an uncaught exception is reported explicitly by
  // our own code, per §D, not relied on to show up here). Traces are sampled at
  // 1% into Cloudflare's own dashboard only — no `destinations`, since ADR §C.4
  // exports no trace anywhere (contract §1: "There is no trace route").
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "invocation_logs": false,
      "persist": true,
      "destinations": ["o11y-logs"]
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.01, "persist": true }
  },

  // Backstop for a runaway Worker invocation (default is 30s on Paid; stated
  // here so it is a decision rather than a default).
  "limits": { "cpu_ms": 30000 },

  // Nightly cost reconciliation + revoked-artifact GC (src/reconcile.ts), at
  // 04:17 UTC (after Cloudflare's day-in-arrears usage processing, off the hour
  // so it does not queue behind every other cron on the platform), plus the
  // ADR-0041 §D `*/5` observability tick (pool.gauge, budget.gauge, the o11y
  // heartbeat check — src/index.ts `scheduled()` dispatches on `controller.cron`).
  "triggers": { "crons": ["17 4 * * *", "*/5 * * * *"] },
  // Keep the workers.dev URL enabled alongside the custom-domain routes
  // (attached at deploy time — see the `deploy` script and the routes note below).
  "workers_dev": true,

  // Per-deploy version id (Cloudflare-managed), used as the Sentry release so
  // an issue points at the exact deployment that introduced it. Still preferred
  // over injecting a git SHA by hand, but the doubt this note used to record —
  // whether `--var` merges cleanly with the `vars` block below — is now measured
  // and settled: `wrangler deploy --dry-run --var SENTRY_ENVIRONMENT:api-production`
  // prints every var from this file PLUS the flag-supplied one. DEV-2540 relies on
  // that, and the `deploy` script passes it alongside the four `--routes` flags.
  //
  // A flag-supplied var renders as `(hidden)` in wrangler's binding table. That is
  // a display convention for values that did not come from config — it reads off
  // `env` at runtime exactly like the ones below, so it is not a broken binding.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Public, non-secret config.
  "vars": {
    "LOGIN_BROKER_URL": "https://mcp-auth-proxy-j0tb.onrender.com",
    // Sentry ingest endpoint. A DSN is write-only and is public by construction
    // (the browser SDK ships it in the bundle), so it lives here rather than in
    // `wrangler secret` — no Cloudflare secret access needed to change it.
    // Abuse is bounded Sentry-side (allowed domains, inbound filters, spike
    // protection), not by hiding this string.
    // The key is NOT `SENTRY_DSN`: @sentry/cloudflare auto-reads that exact name
    // off env, which would initialise the SDK in `wrangler dev` too and file
    // local runs as api-production issues. See src/sentry-gate.ts.
    // Since DEV-2540 this DSN alone no longer enables reporting: the gate also
    // requires SENTRY_ENVIRONMENT, which exists only as a `--var` on the `deploy`
    // script. Nothing in this file, on its own, can turn reporting on.
    "ERROR_REPORTING_DSN": "https://da4d7c549a5ac69c61bfe44be68873bd@o95873.ingest.us.sentry.io/4511806997135360",
    "EMBED_ALLOWED_ANCESTORS": "https://handsontable.com https://*.handsontable.com https://*.handsontable-docs-staging.pages.dev http://localhost:*",
    // Wildcard base host for Tier-2 container preview URLs
    // (<port>-<sandboxId>-<token>.demos.handsontable.com).
    "PREVIEW_HOST": "demos.handsontable.com",
    // Demo-runtime monitoring (DEV-2527). "1" injects the monitor into proxied
    // preview documents; anything else, or removing this line, turns it off — see
    // docs/run-and-deploy.md. The browser half is VITE_MONITOR_DEMOS in
    // apps/authoring/.env.production, and both must be on for a Tier-2 event to be
    // both raised and filed.
    "MONITOR_DEMOS": "1",

    // ---- Cost guardrails (DEV-2030) -------------------------------------
    // Cloudflare's own Budget alerts (configured in the dashboard) only email;
    // they cap nothing. This is the enforced ceiling.
    // See docs/cost-guardrails.md for the arithmetic behind the tiers.
    "BUDGET_MONTHLY_USD": "1000",
    "BUDGET_WARN_PCT": "0.60",        // notice in the authoring UI
    "BUDGET_ANON_BLOCK_PCT": "0.80",  // live sessions require a login
    "BUDGET_NEW_BLOCK_PCT": "0.95",   // no new sessions or builds
    "BUDGET_CLOSED_PCT": "1.00",      // tear down live sessions, static only
    // Observe-only until the metered spend has been compared against the
    // Billable Usage dashboard for a week. Flip to "1" to start refusing.
    "BUDGET_ENFORCE": "0",
    // In-app spend alerts (Sentry + logs) on *this runner's* metered spend —
    // Cloudflare's own budget alerts are account-wide and cannot tell the
    // runner apart from everything else billing to the account.
    "BUDGET_ALERTS_USD": "200,500,800",
    // Anonymous audience data retention. Visitor hashes are dropped after
    // this many days; the daily aggregates behind them carry no identity.
    "ANALYTICS_RETENTION_DAYS": "180",
    // Purge R2 artifacts of demos revoked longer ago than this many days.
    // 0 = disabled; turn on deliberately, it deletes bytes.
    "BUDGET_R2_GC_DAYS": "0",
    // Account tag for the GraphQL Analytics API used by the nightly job, plus
    // the scope it filters on — the account is shared with a dozen other
    // Workers, so an unscoped query would bill their traffic to this runner.
    "CF_ACCOUNT_ID": "15111272c53ed0aaf84a908f0c9c7f8b",
    "CF_SCRIPT_NAME": "handsontable-demos-api",
    "R2_BUCKET_NAME": "handsontable-demos",

    // ---- Example chat (DEV-2047) ----------------------------------------
    // Non-secret config only. The virtual key (LITELLM_API_KEY) and the
    // Algolia search key (ALGOLIA_API_KEY) are `wrangler secret`s — without
    // the former, /api/chat answers 503 and nothing else changes.
    "LITELLM_API_BASE": "https://litellm.handsontable.com",
    "LITELLM_MODEL": "claude-sonnet-4-6",
    // DocSearch app id + index for the docs page lookup. The app id is public
    // by construction — DocSearch ships it in every docs page bundle.
    "ALGOLIA_APP_ID": "MMN6OTJMGX",
    "ALGOLIA_INDEX": "handsontable",

    // ---- Observability (ADR-0041) — scaffold-only addition (T00) ---------
    // `full` | `uncaught` (contract §11): which handled-error reports also go
    // to Sentry. Value only — nothing in this worker reads it yet (T05 wires
    // it). Default per the contract, so today's behaviour (everything Sentry
    // sees today keeps reaching it) does not change by adding this var.
    "SENTRY_SCOPE": "full"
  },

  // ---- Observability (ADR-0041) — scaffold-only additions (T00) ----------
  // Declared so T05 wires real usage against a stable binding shape; nothing
  // in this worker writes to either yet.
  "analytics_engine_datasets": [{ "binding": "RUNNER_EVENTS", "dataset": "runner_events" }],
  "services": [{ "binding": "O11Y", "service": "handsontable-demos-o11y" }],

  // Routes on demos.handsontable.com are deliberately NOT declared here — they
  // are passed via `--routes` in the `deploy` script (package.json). When routes
  // are present in this file, `wrangler dev` simulates the first route's host on
  // EVERY request (request.url and Host become demos.handsontable.com), which
  // destroys the <port>-<sandboxId>-<token>.* preview hostnames that
  // proxyToSandbox() routes by, breaking Tier-2 local preview entirely.
  // With no routes here, wrangler dev passes the real Host through and
  // *.localhost:8787 preview URLs hit the same proxy path as production.

  // D1 — demo metadata + short ids (account 15111272, region EEUR).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handsontable-demos",
      "database_id": "5fc0854f-d348-487f-9531-2c44cc86d182",
      "migrations_dir": "migrations"
    }
  ],

  // KV — edge read-cache for demo JSON.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "6620876d996d45f9ac69b2a6b59909e6"
    }
  ],

  // R2 — source snapshots + built static artifacts.
  // NOTE: the bucket must be created once R2 is enabled on the account
  //   (Dashboard -> R2 -> Enable, then `wrangler r2 bucket create handsontable-demos`).
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "handsontable-demos"
    }
  ],

  // Tier-2 live editing — Cloudflare Sandbox SDK. proxyToSandbox() requires a
  // single `Sandbox` namespace, so ONE generic image serves every framework
  // (deps installed per session). Builder runs the share snapshotter.
  //
  // `max_instances` is the container spend cap AND the concurrency limit for
  // live previews: no queue sits in front of the pool, so the caller past the
  // last slot gets Cloudflare's "maximum number of running container instances
  // exceeded", which we turn into a 503 `at_capacity` refusal
  // (src/session-lifecycle.ts). Raised 5/3 -> 10/5 for
  // DEV-2909 on ~600 sessions/day against metered container spend of ~$5/mo,
  // two orders of magnitude below the cap's own arithmetic. That arithmetic —
  // the only thing these two numbers may not be changed without redoing — is
  // in docs/cost-guardrails.md.
  "containers": [
    { "class_name": "Sandbox", "image": "../../containers/live/Dockerfile", "instance_type": "standard-1", "max_instances": 10 },
    { "class_name": "BuilderSandbox", "image": "../../containers/builder/Dockerfile", "instance_type": "standard-1", "max_instances": 5 }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "BuilderSandbox", "name": "SANDBOX_BUILDER" },
      // Detached snapshot builds for the MCP service path (src/snapshot-jobs.ts).
      // Deliberately NOT in "containers": it is a plain sqlite DO whose alarm
      // *drives* a BuilderSandbox container, it does not front one itself.
      { "class_name": "BuildJob", "name": "BUILD_JOBS" }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "RemixSandbox", "AngularSandbox", "NextSandbox",
        "NextShadcnSandbox", "AstroSandbox", "NuxtSandbox", "BuilderSandbox"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["Sandbox"],
      "deleted_classes": [
        "RemixSandbox", "AngularSandbox", "NextSandbox",
        "NextShadcnSandbox", "AstroSandbox", "NuxtSandbox"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["BuildJob"],
      "tag": "v3"
    }
  ]
}
