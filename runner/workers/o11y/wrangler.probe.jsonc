{
  // Probe-only config (COMMON.md "Sandbox probes" rule) — deploys to the
  // sandbox account, never the feature's real `wrangler.jsonc`. Every
  // resource is prefixed `o11y-probe-t02` and deleted after the probe (see
  // the T02 task Outcome for what was created/deleted).
  //
  // Only what the probe actually needs to exercise `/telemetry/v1/logs`
  // (the route under test) is kept — no `services` binding (the API worker
  // does not exist on this account), no `ACCESS_*`/GitHub OIDC secrets (the
  // probe never hits `/grafana/*` or `/telemetry/deploy`), no
  // production-shaped EU R2 jurisdiction (this is throwaway data, deleted
  // within the hour).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handsontable-demos-o11y-probe-t02",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // workers_dev: true — the probe needs a real, reachable HTTPS URL for
  // Cloudflare's own OTLP log export to POST to; the production config's
  // `workers_dev: false` only works because production reaches this Worker
  // through zone routes, which this probe has none of.
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": true, "destinations": [] },
    "traces": { "enabled": false }
  },

  "limits": { "cpu_ms": 30000 },

  "vars": {
    "O11Y_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "handsontable.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "GITHUB_OIDC_REPOSITORY": "handsontable/examples",
    // Plain `vars`, not `wrangler secret put` — a throwaway probe secret,
    // deleted with everything else within the hour.
    "O11Y_EXPORT_SECRET": "o11y-probe-t02-secret"
  },

  "r2_buckets": [{ "binding": "O11Y_INBOX", "bucket_name": "o11y-probe-t02-inbox" }],

  "analytics_engine_datasets": [{ "binding": "RUNNER_EVENTS", "dataset": "o11y_probe_t02_events" }],

  "durable_objects": {
    "bindings": [
      { "class_name": "InboxWriter", "name": "INBOX_WRITER" },
      { "class_name": "GrafanaBox", "name": "GRAFANA_BOX" }
    ]
  },
  "migrations": [{ "new_sqlite_classes": ["InboxWriter", "GrafanaBox"], "tag": "v1" }],

  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 1000, "period": 60 } }
  ]
}
