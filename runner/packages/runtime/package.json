{
  "name": "@handsontable/demo-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandpack": {
      "types": "./dist/sandpack.d.ts",
      "default": "./dist/sandpack.js"
    },
    "./container": {
      "types": "./dist/container.d.ts",
      "default": "./dist/container.js"
    },
    "./failure-log": {
      "types": "./dist/failure-log.d.ts",
      "default": "./dist/failure-log.js"
    },
    "./monitor": {
      "types": "./dist/monitor.d.ts",
      "default": "./dist/monitor.js"
    },
    "./scheme": {
      "types": "./dist/scheme.d.ts",
      "default": "./dist/scheme.js"
    },
    "./entry-script": {
      "types": "./dist/entry-script.d.ts",
      "default": "./dist/entry-script.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "@codesandbox/sandpack-client": "^2.19.8",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/semver": "^7.5.8"
  }
}
