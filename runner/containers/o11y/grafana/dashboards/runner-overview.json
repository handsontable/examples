    {
      "id": 7,
      "type": "timeseries",
      "title": "api.request 5xx rate by route_class",
      "description": "api.request count where outcome=5xx, by route_class.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "clickhouse-runner-events"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
