          "query": "SELECT toStartOfInterval(timestamp, INTERVAL '$interval' SECOND) AS t, blob10 AS route_class, sum(_sample_interval * double1) AS cnt FROM $table WHERE $timeFilterByColumn(timestamp) AND index1 = 'api.request' AND blob3 = '$environment' AND blob8 = '5xx' GROUP BY t, route_class ORDER BY t",
