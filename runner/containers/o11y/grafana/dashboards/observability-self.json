      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "clickhouse-runner-events"
          },
          "query": "SELECT toStartOfInterval(timestamp, INTERVAL '$interval' SECOND) AS t, blob8 AS outcome, sum(_sample_interval * double4) AS usd_drift FROM $table WHERE $timeFilterByColumn(timestamp) AND index1 = 'reconcile.run' AND blob3 = '$environment' GROUP BY t, outcome ORDER BY t",
