    {
      "id": 7,
      "type": "timeseries",
      "title": "reconcile.run usd drift by outcome",
      "description": "reconcile.run double4 (billing minus estimate, §4) summed per bucket, by outcome.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
