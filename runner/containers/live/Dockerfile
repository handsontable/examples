# Generated by scripts/prepare-container.mjs — do not edit by hand.
# One generic Tier-2 image. Each framework's node_modules is baked into
# /baked/<key>; the Worker hardlink-copies the right one into /app at session
# start so a default-version boot skips `npm install`. proxyToSandbox requires
# a single `Sandbox` namespace, hence one shared image.
FROM docker.io/cloudflare/sandbox:0.12.3

WORKDIR /app

# react-js
COPY baked/react-js/package.json /baked/react-js/package.json
RUN cd /baked/react-js && npm install --no-audit --no-fund --loglevel=error

# ant-design
COPY baked/ant-design/package.json /baked/ant-design/package.json
RUN cd /baked/ant-design && npm install --no-audit --no-fund --loglevel=error

# mui
COPY baked/mui/package.json /baked/mui/package.json
RUN cd /baked/mui && npm install --no-audit --no-fund --loglevel=error

# base-web
COPY baked/base-web/package.json /baked/base-web/package.json
RUN cd /baked/base-web && npm install --no-audit --no-fund --loglevel=error

# angular
COPY baked/angular/package.json /baked/angular/package.json
RUN cd /baked/angular && npm install --legacy-peer-deps --no-audit --no-fund --loglevel=error

# next.js
COPY baked/next-js/package.json /baked/next-js/package.json
RUN cd /baked/next-js && npm install --no-audit --no-fund --loglevel=error

# next-shadcn.js
COPY baked/next-shadcn-js/package.json /baked/next-shadcn-js/package.json
RUN cd /baked/next-shadcn-js && npm install --no-audit --no-fund --loglevel=error

# astro
COPY baked/astro/package.json /baked/astro/package.json
RUN cd /baked/astro && npm install --no-audit --no-fund --loglevel=error

# nuxt
COPY baked/nuxt/package.json /baked/nuxt/package.json
RUN cd /baked/nuxt && npm install --no-audit --no-fund --loglevel=error

# remix
COPY baked/remix/package.json /baked/remix/package.json
RUN cd /baked/remix && npm install --no-audit --no-fund --loglevel=error

# vue
COPY baked/vue/package.json /baked/vue/package.json
RUN cd /baked/vue && npm install --no-audit --no-fund --loglevel=error

EXPOSE 3001 4200 4321 5173
