{
  "name": "@handsontable/demo-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted live demo runner for Handsontable examples and documentation guides (replaces CodeSandbox).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "import": "node pipeline/import.mjs",
    "import-docs": "node pipeline/import-docs.mjs",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @handsontable/demo-runtime build && node --test pipeline/*.test.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "~5.6.0"
  }
}
