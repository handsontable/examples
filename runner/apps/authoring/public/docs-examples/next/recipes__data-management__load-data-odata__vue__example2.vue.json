{"framework":"vue","displayName":"Recipes ▸ Data Management ▸ Load data from an OData service · Step 3: Fill an autocomplete cell from the service · Vue 3","tier":2,"engine":"container","sandpackTemplate":null,"sandpackEnvironment":null,"container":"vue","htWrappers":["@handsontable/vue3"],"entry":"/src/main.ts","htmlEntry":"/index.html","devCommand":"pnpm exec vite --host 0.0.0.0 --port 5173","buildCommand":"vite build","outputDir":"dist","outputGlob":null,"staticExport":false,"spaMode":false,"port":5173,"installCommand":"pnpm install","htCoreRange":"0.0.0-next-193d031-20261028","fileCount":5,"assets":[],"skipped":[],"files":{"/package.json":"{\n  \"name\": \"handsontable-vue-example\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"packageManager\": \"pnpm@10.34.5\",\n  \"dependencies\": {\n    \"handsontable\": \"0.0.0-next-193d031-20261028\",\n    \"@handsontable/vue3\": \"0.0.0-next-193d031-20261028\",\n    \"vue\": \"3.x\",\n    \"vite\": \"^5.4.0\",\n    \"@vitejs/plugin-vue\": \"^5.0.0\"\n  },\n  \"scripts\": {\n    \"start\": \"vite\",\n    \"build\": \"vite build\"\n  }\n}","/vite.config.js":"import { defineConfig } from \"vite\";\nimport vue from \"@vitejs/plugin-vue\";\n\nexport default defineConfig({ plugins: [vue()], server: { allowedHosts: true } });","/index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Handsontable Vue Example</title>\n</head>\n<body>\n  <div id=\"example2\"></div>\n  <script type=\"module\" src=\"/src/main.ts\"></script>\n</body>\n</html>","/src/main.ts":"import { createApp } from \"vue\";\nimport App from \"./App.vue\";\ncreateApp(App).mount(\"#example2\");","/src/App.vue":"<script setup lang=\"ts\">\nimport { HotTable } from '@handsontable/vue3';\nimport { registerAllModules } from 'handsontable/registry';\nimport type { GridSettings } from 'handsontable/settings';\n\nregisterAllModules();\n\nconst SERVICE_URL = 'https://services.odata.org/V4/Northwind/Northwind.svc/Products';\n\n// Ask the OData service for up to 10 product names that contain the typed text.\nasync function fetchProductNames(query: string): Promise<string[]> {\n  const term = query.toLowerCase().replace(/'/g, \"''\");\n  const params = new URLSearchParams({\n    $select: 'ProductName',\n    $top: '10',\n    $orderby: 'ProductName',\n    $filter: `contains(tolower(ProductName),'${term}')`,\n  });\n  const response = await fetch(`${SERVICE_URL}?${params}`);\n\n  if (!response.ok) {\n    throw new Error(`HTTP ${response.status}`);\n  }\n\n  const json = await response.json();\n\n  return json.value.map((product: { ProductName: string }) => product.ProductName);\n}\n\nconst hotSettings: GridSettings = {\n  data: [\n    { order: 'SO-10248', product: 'Queso Cabrales', quantity: 12 },\n    { order: 'SO-10249', product: 'Tofu', quantity: 9 },\n    { order: 'SO-10250', product: 'Manjimup Dried Apples', quantity: 35 },\n    { order: 'SO-10251', product: 'Ravioli Angelo', quantity: 6 },\n    { order: 'SO-10252', product: 'Chang', quantity: 25 },\n  ],\n  colHeaders: ['Order', 'Product', 'Quantity'],\n  columns: [\n    { data: 'order', readOnly: true },\n    {\n      data: 'product',\n      type: 'autocomplete',\n      width: 240,\n      strict: false,\n      // Show no suggestions when the request fails.\n      source(query, process) {\n        fetchProductNames(query).then(process, () => process([]));\n      },\n    },\n    { data: 'quantity', type: 'numeric' },\n  ],\n  height: 'auto',\n  licenseKey: 'non-commercial-and-evaluation',\n};\n</script>\n\n<template>\n  <div id=\"example2\">\n    <HotTable :settings=\"hotSettings\" />\n  </div>\n</template>"},"docsPath":"recipes/data-management/load-data-odata/vue/example2.vue","breadcrumb":["Recipes","Data Management","Load data from an OData service"],"guide":"recipes/data-management/load-data-odata/load-data-odata.md","guideTitle":"Load data from an OData service","exampleId":"example2","exampleTitle":"Step 3: Fill an autocomplete cell from the service","docPermalink":"/recipes/data-management/load-data-odata","lang":"Vue 3"}
