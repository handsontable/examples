{"framework":"vue","displayName":"Cell Types ▸ Numeric cell type · Preserve the typed literal · Vue 3","tier":2,"engine":"container","sandpackTemplate":null,"sandpackEnvironment":null,"container":"vue","htWrappers":["@handsontable/vue3"],"entry":"/src/main.ts","htmlEntry":"/index.html","devCommand":"pnpm exec vite --host 0.0.0.0 --port 5173","buildCommand":"vite build","outputDir":"dist","outputGlob":null,"staticExport":false,"spaMode":false,"port":5173,"installCommand":"pnpm install","htCoreRange":"0.0.0-next-d4c3c26-20261020","fileCount":5,"assets":[],"skipped":[],"files":{"/package.json":"{\n  \"name\": \"handsontable-vue-example\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"packageManager\": \"pnpm@10.34.5\",\n  \"dependencies\": {\n    \"handsontable\": \"0.0.0-next-d4c3c26-20261020\",\n    \"@handsontable/vue3\": \"0.0.0-next-d4c3c26-20261020\",\n    \"vue\": \"3.x\",\n    \"vite\": \"^5.4.0\",\n    \"@vitejs/plugin-vue\": \"^5.0.0\"\n  },\n  \"scripts\": {\n    \"start\": \"vite\",\n    \"build\": \"vite build\"\n  }\n}","/vite.config.js":"import { defineConfig } from \"vite\";\nimport vue from \"@vitejs/plugin-vue\";\n\nexport default defineConfig({ plugins: [vue()], server: { allowedHosts: true } });","/index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Handsontable Vue Example</title>\n</head>\n<body>\n  <div id=\"example2\"></div>\n  <script type=\"module\" src=\"/src/main.ts\"></script>\n</body>\n</html>","/src/main.ts":"import { createApp } from \"vue\";\nimport App from \"./App.vue\";\ncreateApp(App).mount(\"#example2\");","/src/App.vue":"<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { HotTable, HotColumn } from '@handsontable/vue3';\nimport { registerAllModules } from 'handsontable/registry';\nimport type { GridSettings } from 'handsontable/settings';\n\n// register Handsontable's modules\nregisterAllModules();\n\nconst readout = ref('Edit a cell in the Default or preserveNumericLiteral column to see the stored value.');\n\nconst hotData = [\n  ['Stainless Steel Water Bottle', 24.5, 24.5],\n  ['Wireless Mouse', 18, 18],\n  ['USB-C Charging Cable', 9.9, 9.9],\n  ['Desk Lamp', 32, 32],\n  ['Notebook A5', 4.75, 4.75],\n];\n\n// A plain object, so updating the readout does not trigger `updateSettings()`.\nconst hotSettings: GridSettings = {\n  colHeaders: ['Product', 'Default', 'preserveNumericLiteral: true'],\n  height: 'auto',\n  autoWrapRow: true,\n  autoWrapCol: true,\n  afterChange(changes, source) {\n    if (source === 'loadData' || !changes) {\n      return;\n    }\n\n    const [row, prop] = changes[changes.length - 1];\n    const column = prop as number;\n    const value = this.getDataAtCell(row, column);\n    const label = column === 1 ? 'Default' : 'preserveNumericLiteral';\n\n    readout.value = `${label} stores: ${JSON.stringify(value)} (${typeof value})`;\n  },\n  licenseKey: 'non-commercial-and-evaluation',\n};\n</script>\n\n<template>\n  <div id=\"example2\">\n    <HotTable :data=\"hotData\" :settings=\"hotSettings\">\n      <HotColumn type=\"text\" :readOnly=\"true\" :width=\"240\" />\n      <HotColumn type=\"numeric\" />\n      <HotColumn type=\"numeric\" :preserveNumericLiteral=\"true\" />\n    </HotTable>\n    <p id=\"example2-readout\" aria-live=\"polite\">{{ readout }}</p>\n  </div>\n</template>"},"docsPath":"guides/cell-types/numeric-cell-type/vue/example2.vue","breadcrumb":["Cell Types","Numeric cell type"],"guide":"guides/cell-types/numeric-cell-type/numeric-cell-type.md","guideTitle":"Numeric cell type","exampleId":"example2","exampleTitle":"Preserve the typed literal","docPermalink":"/numeric-cell-type","lang":"Vue 3"}
