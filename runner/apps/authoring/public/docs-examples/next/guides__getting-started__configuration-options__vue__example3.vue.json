C1', 'D1', 'E1', 'F1', 'G1', 'H1', 'I1', 'J1'],\n    ['A2', 'B2', 'C2', 'D2', 'E2', 'F2', 'G2', 'H2', 'I2', 'J2'],\n    ['A3', 'B3', 'C3', 'D3', 'E3', 'F3', 'G3', 'H3', 'I3', 'J3'],\n    ['A4', 'B4', 'C4', 'D4', 'E4', 'F4', 'G4', 'H4', 'I4', 'J4'],\n    ['A5', 'B5', 'C5', 'D5', 'E5', 'F5', 'G5', 'H5', 'I5', 'J5'],\n  ],\n  autoWrapRow: true,\n  autoWrapCol: true,\n  width: 'auto',\n  height: 'auto',\n  rowHeaders: true,\n  colHeaders: true,\n  cells(row) {\n    if (row === 1 || row === 4) {\n      return { readOnly: true };\n    }\n    return {};\n  },\n  licenseKey: 'non-commercial-and-evaluation',\n});\n</script>\n\n<template>\n  <div id=\"example3\">\n    <HotTable :settings=\"hotSettings\" />\n  </div>\n</template>"},"docsPath":"guides/getting-started/configuration-options/vue/example3.vue","breadcrumb":["Getting Started","Configuration options"],"guide":"guides/getting-started/configuration-options/configuration-options.md","guideTitle":"Configuration options","exampleId":"example3","exampleTitle":"Example (2)","docPermalink":"/configuration-options","lang":"Vue 3"}
