a-ui';\nimport type { GridSettings } from 'handsontable/settings';\n\nregisterAllModules();\n\nconst hotSettings: GridSettings = {\n  data: [\n    ['Acme Corp', 1250, 1480, 1310, '=SUM(B1:D1)', '=E1/$E$7'],\n    ['Vertex Industries', 890, 940, 1020, '=SUM(B2:D2)', '=E2/$E$7'],\n    ['Harbor Goods', 640, 580, 710, '=SUM(B3:D3)', '=E3/$E$7'],\n    ['Alpine Supply Co.', 1120, 1060, 990, '=SUM(B4:D4)', '=E4/$E$7'],\n    ['Nimbus Software', 1540, 1620, 1735, '=SUM(B5:D5)', '=E5/$E$7'],\n    ['Quill Media', 430, 510, 480, '=SUM(B6:D6)', '=E6/$E$7'],\n    ['All companies', '=SUM(B1:B6)', '=SUM(C1:C6)', '=SUM(D1:D6)', '=SUM(E1:E6)', '=SUM(F1:F6)'],\n  ],\n  colHeaders: ['Company', 'Q1 2025', 'Q2 2025', 'Q3 2025', 'Total', 'Share'],\n  rowHeaders: true,\n  height: 342,\n  editor: 'formula',\n  formulas: {\n    engine: HyperFormula,\n  },\n  formulaBuilder: {\n    builder: formulaBuilder,\n    showFormulaBar: true,\n  },\n  autoWrapRow: true,\n  autoWrapCol: true,\n  licenseKey: 'non-commercial-and-evaluation',\n};\n</script>\n\n<template>\n  <div id=\"example1\">\n    <HotTable :settings=\"hotSettings\" />\n  </div>\n</template>"},"docsPath":"guides/formulas/formula-builder/vue/example1.vue","breadcrumb":["Formulas","Formula builder"],"guide":"guides/formulas/formula-builder/formula-builder.md","guideTitle":"Formula builder","exampleId":"example1","exampleTitle":"Standard example","docPermalink":"/formula-builder","lang":"Vue 3"}
