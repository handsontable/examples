 ref<GridSettings>({\n  data: [\n    { id: 1, name: { first: 'Ted', last: 'Right' }, address: '' },\n    { id: 2, address: '' },\n    { id: 3, name: { first: 'Joan', last: 'Well' }, address: '' },\n  ],\n  colHeaders: true,\n  height: 'auto',\n  width: 'auto',\n  columns: [{ data: 'id' }, { data: 'name.first' }, { data: 'name.last' }, { data: 'address' }],\n  autoWrapRow: true,\n  autoWrapCol: true,\n  licenseKey: 'non-commercial-and-evaluation',\n});\n</script>\n\n<template>\n  <div id=\"example5\">\n    <HotTable :settings=\"hotSettings\" />\n  </div>\n</template>"},"docsPath":"guides/getting-started/binding-to-data/vue/example5.vue","breadcrumb":["Getting Started","Binding to data"],"guide":"guides/getting-started/binding-to-data/binding-to-data.md","guideTitle":"Binding to data","exampleId":"example5","exampleTitle":"Array of objects with column mapping","docPermalink":"/binding-to-data","lang":"Vue 3"}
