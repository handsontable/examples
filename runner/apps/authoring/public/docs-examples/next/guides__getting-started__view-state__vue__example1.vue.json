{"framework":"vue","displayName":"Getting Started ▸ Save and restore the view state · Standard example · Vue 3","tier":2,"engine":"container","sandpackTemplate":null,"sandpackEnvironment":null,"container":"vue","htWrappers":["@handsontable/vue3"],"entry":"/src/main.ts","htmlEntry":"/index.html","devCommand":"pnpm exec vite --host 0.0.0.0 --port 5173","buildCommand":"vite build","outputDir":"dist","outputGlob":null,"staticExport":false,"spaMode":false,"port":5173,"installCommand":"pnpm install","htCoreRange":"0.0.0-next-963c44a-20261021","fileCount":5,"assets":[],"skipped":[],"files":{"/package.json":"{\n  \"name\": \"handsontable-vue-example\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"packageManager\": \"pnpm@10.34.5\",\n  \"dependencies\": {\n    \"handsontable\": \"0.0.0-next-963c44a-20261021\",\n    \"@handsontable/vue3\": \"0.0.0-next-963c44a-20261021\",\n    \"vue\": \"3.x\",\n    \"vite\": \"^5.4.0\",\n    \"@vitejs/plugin-vue\": \"^5.0.0\"\n  },\n  \"scripts\": {\n    \"start\": \"vite\",\n    \"build\": \"vite build\"\n  }\n}","/vite.config.js":"import { defineConfig } from \"vite\";\nimport vue from \"@vitejs/plugin-vue\";\n\nexport default defineConfig({ plugins: [vue()], server: { allowedHosts: true } });","/index.html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Handsontable Vue Example</title>\n</head>\n<body>\n  <div id=\"example1\"></div>\n  <script type=\"module\" src=\"/src/main.ts\"></script>\n</body>\n</html>","/src/main.ts":"import { createApp } from \"vue\";\nimport App from \"./App.vue\";\ncreateApp(App).mount(\"#example1\");","/src/App.vue":"<script setup lang=\"ts\">\nimport { ref, useTemplateRef } from 'vue';\nimport { HotTable } from '@handsontable/vue3';\nimport { registerAllModules } from 'handsontable/registry';\nimport type { GridSettings } from 'handsontable/settings';\n\nregisterAllModules();\n\nconst hotRef = useTemplateRef<InstanceType<typeof HotTable>>('hotRef');\nconst output = ref('Sort, filter, hide, or resize columns, then click \"Save view\"');\n\n// The saved view is plain JSON, so you can keep it in a variable, `localStorage`, or on a server.\nlet savedView: string | null = null;\n\nconst hotSettings: GridSettings = {\n  data: [\n    ['Laptop Pro 14', 'Computers', 1499, 24, 4.7],\n    ['Wireless Mouse', 'Accessories', 29, 310, 4.4],\n    ['Mechanical Keyboard', 'Accessories', 119, 85, 4.8],\n    ['4K Monitor 27\"', 'Displays', 449, 41, 4.6],\n    ['USB-C Dock', 'Accessories', 189, 67, 4.2],\n    ['Tablet Air 11', 'Computers', 599, 52, 4.5],\n    ['Webcam HD', 'Accessories', 79, 140, 4.1],\n    ['Ultrawide Monitor 34\"', 'Displays', 799, 18, 4.9],\n  ],\n  colHeaders: ['Product', 'Category', 'Price', 'Stock', 'Rating'],\n  rowHeaders: true,\n  columnSorting: true,\n  filters: true,\n  dropdownMenu: true,\n  contextMenu: true,\n  hiddenColumns: { indicators: true },\n  manualColumnResize: true,\n  height: 'auto',\n  licenseKey: 'non-commercial-and-evaluation',\n};\n\nfunction saveClickCallback() {\n  const hot = hotRef.value!.hotInstance!;\n\n  savedView = JSON.stringify(hot.getPlugin('viewState').getViewState());\n  output.value = 'View saved';\n}\n\nfunction restoreClickCallback() {\n  const hot = hotRef.value!.hotInstance!;\n\n  if (savedView === null) {\n    output.value = 'Save a view first';\n\n    return;\n  }\n\n  const { skipped } = hot.getPlugin('viewState').setViewState(JSON.parse(savedView));\n\n  output.value = skipped.length === 0\n    ? 'View restored'\n    : `View restored, skipped: ${skipped.map(({ part, reason }) => `${part} (${reason})`).join(', ')}`;\n}\n</script>\n\n<template>\n  <div id=\"example1\">\n    <div class=\"example-controls-container\">\n      <div class=\"controls\">\n        <button id=\"save\" class=\"button button--primary button--blue\" @click=\"saveClickCallback\">\n          Save view\n        </button>\n        <button id=\"restore\" class=\"button button--primary button--blue\" @click=\"restoreClickCallback\">\n          Restore view\n        </button>\n      </div>\n      <output class=\"console\" id=\"output\">{{ output }}</output>\n    </div>\n    <HotTable ref=\"hotRef\" :settings=\"hotSettings\" />\n  </div>\n</template>\n\n<style scoped>\n.controls {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n}\n</style>"},"docsPath":"guides/getting-started/view-state/vue/example1.vue","breadcrumb":["Getting Started","Save and restore the view state"],"guide":"guides/getting-started/view-state/view-state.md","guideTitle":"Save and restore the view state","exampleId":"example1","exampleTitle":"Standard example","docPermalink":"/view-state","lang":"Vue 3"}
